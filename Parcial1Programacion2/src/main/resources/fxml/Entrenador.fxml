<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="viewController.EntrenadorViewController"
      spacing="10">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Registro de Entrenador"/>

    <Label text="Identificación"/>
    <TextField fx:id="txtIdentificacion"
               promptText="Ingrese la identificación"/>

    <Label text="Nombre"/>
    <TextField fx:id="txtNombre"
               promptText="Ingrese el nombre"/>

    <Label text="Especialidad"/>
    <TextField fx:id="txtEspecialidad"
               promptText="Ingrese la especialidad"/>

    <Label text="Teléfono"/>
    <TextField fx:id="txtTelefono"
               promptText="Ingrese el teléfono"/>

    <Label text="Tarifa por sesión"/>
    <TextField fx:id="txtTarifaPorSesion"
               promptText="Ingrese la tarifa"/>

    <Button text="Registrar entrenador"
            onAction="#registrarEntrenador"/>

</VBox>