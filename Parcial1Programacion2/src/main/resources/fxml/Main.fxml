                                <HBox spacing="18"><VBox spacing="12" styleClass="panel" HBox.hgrow="ALWAYS"><Label styleClass="panel-title" text="Número perfecto" /><Label styleClass="h-desc" text="Consulta si un número de teléfono es perfecto." /><HBox spacing="10"><TextField fx:id="txtNumeroPerfecto" promptText="Ej. 28" styleClass="field" HBox.hgrow="ALWAYS" /><Button onAction="#comprobarNumeroPerfecto" styleClass="btn-secondary" text="Comprobar" /></HBox><Label fx:id="lblResultadoPerfecto" styleClass="result-box" text="Introduce un número para comprobarlo." /></VBox><VBox prefWidth="300" spacing="12" styleClass="panel"><Label styleClass="panel-title" text="Información del gimnasio" /><Label fx:id="lblGymNombre" styleClass="info-name" text="SmartGym" /><Label fx:id="lblGymNit" styleClass="info-line" text="NIT 123456" /><Label fx:id="lblGymDireccion" styleClass="info-line" text="Universidad del Quindío" /><Label fx:id="lblGymTelefono" styleClass="info-line" text="3000000000" /></VBox></HBox>
