                                </HBox>
                                <VBox spacing="15" styleClass="form-card"><Label styleClass="panel-title" text="Calcular ingresos" /><HBox alignment="BOTTOM_LEFT" spacing="12"><VBox spacing="6"><Label styleClass="field-label" text="Fecha inicial" /><DatePicker fx:id="dpIngresoInicio" styleClass="field" /></VBox><VBox spacing="6"><Label styleClass="field-label" text="Fecha final" /><DatePicker fx:id="dpIngresoFin" styleClass="field" /></VBox><Button onAction="#calcularIngresos" styleClass="primary-button" text="Calcular" /></HBox></VBox>
                                <HBox spacing="18"><VBox spacing="12" styleClass="panel-card" HBox.hgrow="ALWAYS"><Label styleClass="panel-title" text="Número perfecto" /><Label styleClass="module-description" text="Consulta el ejercicio implementado en Gimnasio." /><HBox spacing="10"><TextField fx:id="txtNumeroPerfecto" promptText="Ej. 28" styleClass="field" HBox.hgrow="ALWAYS" /><Button onAction="#comprobarNumeroPerfecto" styleClass="secondary-button" text="Comprobar" /></HBox><Label fx:id="lblResultadoPerfecto" styleClass="result-label" text="Introduce un número para comprobarlo." /></VBox><VBox prefWidth="300" spacing="12" styleClass="panel-card"><Label styleClass="panel-title" text="Información del gimnasio" /><Label fx:id="lblGymNombre" styleClass="info-value" text="SmartGym" /><Label fx:id="lblGymNit" styleClass="info-line" text="NIT 123456" /><Label fx:id="lblGymDireccion" styleClass="info-line" text="Universidad del Quindío" /><Label fx:id="lblGymTelefono" styleClass="info-line" text="3000000000" /></VBox></HBox>
                            </VBox></content></ScrollPane></content>
                        </Tab>
                    </tabs>
                </TabPane>
            </center>
        </BorderPane>
    </center>
