<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="viewController.PlanViewController"
      spacing="10">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <Label text="Registro de Planes de Entrenamiento"/>

    <Label text="Tipo de plan"/>

    <ComboBox fx:id="cmbTipoPlan"
              prefWidth="250"/>

    <Label text="Código"/>

    <TextField fx:id="txtCodigo"
               promptText="Ingrese el código"/>

    <Label text="Nombre"/>

    <TextField fx:id="txtNombre"
               promptText="Ingrese el nombre"/>

    <Label text="Descripción"/>

    <TextField fx:id="txtDescripcion"
               promptText="Ingrese la descripción"/>

    <Label text="Duración en meses"/>

    <TextField fx:id="txtDuracion"
               promptText="Ingrese la duración"/>

    <Label text="Valor mensual"/>

    <TextField fx:id="txtValorMensual"
               promptText="Ingrese el valor mensual"/>

    <Label text="Estado"/>

    <ComboBox fx:id="cmbEstado"
              prefWidth="250"/>

    <!-- Campos exclusivos del plan personalizado -->
    <VBox fx:id="panelPersonalizado"
          spacing="10">

        <Label text="Cantidad de sesiones con entrenador"/>

        <TextField fx:id="txtSesiones"
                   promptText="Ingrese la cantidad de sesiones"/>

        <Label text="Especialidad requerida"/>

        <TextField fx:id="txtEspecialidad"
                   promptText="Ingrese la especialidad"/>

        <Label text="Objetivos del cliente"/>

        <TextField fx:id="txtObjetivos"
                   promptText="Ingrese los objetivos"/>

    </VBox>

    <Button text="Registrar plan"
            onAction="#registrarPlan"/>

</VBox>