<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="viewController.PlanViewController"
            fitToWidth="true"
            fitToHeight="true"
            pannable="true">

    <content>

        <VBox spacing="10">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Label text="Registro de Planes de Entrenamiento"/>

            <Label text="Tipo de plan"/>

            <ComboBox fx:id="cmbTipoPlan"
                      prefWidth="250"/>

            <Label text="Código"/>

            <TextField fx:id="txtCodigo"
                       promptText="Ingrese el código"/>

            <Label text="Nombre"/>

            <TextField fx:id="txtNombre"
                       promptText="Ingrese el nombre"/>

            <Label text="Descripción"/>

            <TextField fx:id="txtDescripcion"
                       promptText="Ingrese la descripción"/>

            <Label text="Duración en meses"/>

            <TextField fx:id="txtDuracion"
                       promptText="Ingrese la duración"/>

            <Label text="Valor mensual"/>

            <TextField fx:id="txtValorMensual"
                       promptText="Ingrese el valor mensual"/>

            <Label text="Estado"/>

            <ComboBox fx:id="cmbEstado"
                      prefWidth="250"/>

            <!-- Beneficios de los planes básico y premium -->
            <VBox fx:id="panelBeneficiosIncluidos"
                  spacing="5">

                <Label text="Beneficios del plan"/>

                <Label fx:id="lblBeneficiosIncluidos"
                       text=""
                       wrapText="true"/>

            </VBox>

            <!-- Campos exclusivos del plan personalizado -->
            <VBox fx:id="panelPersonalizado"
                  spacing="8">

                <Label text="Cantidad de sesiones con entrenador"/>

                <TextField fx:id="txtSesiones"
                           promptText="Ingrese la cantidad de sesiones"/>

                <Label text="Especialidad requerida"/>

                <TextField fx:id="txtEspecialidad"
                           promptText="Ingrese la especialidad"/>

                <Label text="Objetivos del cliente"/>

                <TextField fx:id="txtObjetivos"
                           promptText="Ingrese los objetivos"/>

                <Label text="Seleccione los beneficios"/>

                <CheckBox fx:id="chkAccesoZonas"
                          text="Acceso a zonas deportivas"/>

                <CheckBox fx:id="chkClasesGrupales"
                          text="Clases grupales"/>

                <CheckBox fx:id="chkAcompanamientoEntrenador"
                          text="Acompañamiento con entrenador"/>

            </VBox>

            <Button text="Registrar plan"
                    onAction="#registrarPlan"/>

        </VBox>

    </content>

</ScrollPane>