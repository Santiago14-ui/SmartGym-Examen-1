<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="viewController.ServicioAdicionalViewController"
      spacing="10">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <Label text="Registro de Servicios Adicionales"/>

    <Label text="Código"/>

    <TextField fx:id="txtCodigo"
               promptText="Ingrese el código"/>

    <Label text="Nombre"/>

    <TextField fx:id="txtNombre"
               promptText="Ingrese el nombre"/>

    <Label text="Descripción"/>

    <TextField fx:id="txtDescripcion"
               promptText="Ingrese la descripción"/>

    <Label text="Precio"/>

    <TextField fx:id="txtPrecio"
               promptText="Ingrese el precio"/>

    <Button text="Registrar Servicio"
            onAction="#registrarServicio"/>

    <Label fx:id="lblResultado"/>

</VBox>