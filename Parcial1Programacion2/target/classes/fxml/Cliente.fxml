<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="viewController.ClienteViewController"
      spacing="15"
      prefWidth="500"
      prefHeight="550">

    <Label text="GESTIÓN DE CLIENTES"/>

    <GridPane hgap="10" vgap="10">

        <Label text="Nombre completo:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="txtNombre"
                   promptText="Ingrese el nombre"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>


        <Label text="Documento:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="txtDocumento"
                   promptText="Ingrese el documento"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>


        <Label text="Teléfono:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="txtTelefono"
                   promptText="Ingrese el teléfono"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>


        <Label text="Correo electrónico:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <TextField fx:id="txtCorreo"
                   promptText="Ingrese el correo"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>


        <Label text="Edad:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>

        <TextField fx:id="txtEdad"
                   promptText="Ingrese la edad"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="4"/>

    </GridPane>


    <HBox spacing="10">

        <Button text="Registrar cliente"
                onAction="#registrarCliente"/>

        <Button text="Actualizar"
                onAction="#actualizarCliente"/>

        <Button text="Eliminar"
                onAction="#eliminarCliente"/>

    </HBox>


    <Label text="BUSCAR CLIENTE POR DOCUMENTO"/>

    <HBox spacing="10">

        <TextField fx:id="txtBuscarDocumento"
                   promptText="Ingrese el documento"/>

        <Button text="Buscar"
                onAction="#buscarCliente"/>

    </HBox>


    <Label fx:id="lblResultado"
           wrapText="true"/>

</VBox>