<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="viewController.InscripcionViewController"
      spacing="10">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <Label text="Registro de Inscripciones"/>

    <Label text="Cliente"/>

    <ComboBox fx:id="cmbCliente"
              prefWidth="250"/>

    <Label text="Plan de entrenamiento"/>

    <ComboBox fx:id="cmbPlan"
              prefWidth="250"/>

    <Label text="Entrenador"/>

    <ComboBox fx:id="cmbEntrenador"
              prefWidth="250"/>

    <Label text="Servicio adicional"/>

    <ComboBox fx:id="cmbServicioAdicional"
              prefWidth="250"/>

    <Button text="Registrar inscripción"
            onAction="#registrarInscripcion"/>

</VBox>