<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="viewController.IngresosViewController"
      alignment="CENTER"
      spacing="15">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="SMARTGYM"/>

    <Label text="REPORTE DE INGRESOS"/>

    <Label text="Fecha inicial"/>

    <DatePicker fx:id="dpFechaInicio"/>

    <Label text="Fecha final"/>

    <DatePicker fx:id="dpFechaFin"/>

    <Button text="Consultar ingresos"
            onAction="#consultarIngresos"/>

    <Label fx:id="lblResultado"
           text="Seleccione un período para consultar."/>

</VBox>